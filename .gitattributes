# Auto detect text files and perform LF normalization
* text=auto
*.json text eol=lf
*.js text eol=lf
*.html text eol=lf
*.md   text eol=lf
*.py   text eol=lf
# 🔴 6 ส.ค. 69 — guards.yml เป็นไฟล์เดียวในคลังที่ไม่ได้ตรึงตัวจบบรรทัด
#    GitHub Desktop จึงเตือน "LF → CRLF ตอน checkout ครั้งหน้า" เฉพาะไฟล์นี้
#    ⇒ ตรึงให้เหมือนสกุลอื่นทั้งหมด ⛔ ไม่ปล่อยให้ * text=auto ตัดสินแทน
*.yml  text eol=lf
*.yaml text eol=lf
# 🔴 12 ก.ย. 69 — ครูเคาะ ค (ใบ 368 §2): ไฟล์ไม่มีนามสกุล + .csv เคยตก `* text=auto`
#    ⇒ core.autocrlf=true (ชั้น system ของ Windows) แปลง LF→CRLF ตอน checkout ⇒ GitHub Desktop เตือนที่ .gitignore
#    ⇒ ตรึงให้ครบ · repo นี้ตั้ง core.autocrlf=false ชั้น repo แล้วด้วย (ก) · .bat ต้องเป็น CRLF ตามธรรมชาติของ cmd
.gitignore     text eol=lf
.gitattributes text eol=lf
*.csv          text eol=lf
*.bat          text eol=crlf
